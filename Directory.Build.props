<Project>
	<PropertyGroup>
		<WorkspaceDir>$(MSBuildThisFileDirectory)</WorkspaceDir>
		<RuntimeLibDir>$(WorkspaceDir)libs/runtime/</RuntimeLibDir>
		<SourceLibDir>$(WorkspaceDir)libs/source/</SourceLibDir>

		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<OutputType>Library</OutputType>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<EnableDefaultContentItems>false</EnableDefaultContentItems>
		<Deterministic>true</Deterministic>

		<AssemblyName Condition="'$(AssemblyName)' == ''">$(MSBuildProjectName)</AssemblyName>
		<RootNamespace Condition="'$(RootNamespace)' == ''">$(MSBuildProjectName)</RootNamespace>
		<Name Condition="'$(Name)' == ''">$(MSBuildProjectName)</Name>
		<Version Condition="'$(Version)' == ''">1.0.0</Version>
		<Guid Condition="'$(Guid)' == ''">com.lucidcats.$([System.String]::Copy('$(MSBuildProjectName)').ToLowerInvariant())</Guid>
		<GenerateModMetadata Condition="'$(GenerateModMetadata)' == ''">true</GenerateModMetadata>
		<PluginClass Condition="'$(PluginClass)' == ''">Plugin</PluginClass>

		<IsRuntimeLib>$([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$([System.IO.Path]::GetFullPath('$(RuntimeLibDir)'))'))</IsRuntimeLib>
		<ArtifactKind Condition="'$(IsRuntimeLib)' == 'True'">runtime</ArtifactKind>
		<ArtifactKind Condition="'$(ArtifactKind)' == ''">mods</ArtifactKind>
		<MetadataAccess Condition="'$(IsRuntimeLib)' == 'True'">public</MetadataAccess>
		<MetadataAccess Condition="'$(MetadataAccess)' == ''">internal</MetadataAccess>
		<MetadataNamespace Condition="'$(IsRuntimeLib)' == 'True'">$(MSBuildProjectName)</MetadataNamespace>
		<MetadataNamespace Condition="'$(MetadataNamespace)' == ''">$(RootNamespace)</MetadataNamespace>

		<OutputPath>$(WorkspaceDir)dist/$(ArtifactKind)/$(MSBuildProjectName)/</OutputPath>
		<PackagePath>$(WorkspaceDir)dist/$(ArtifactKind)/$(MSBuildProjectName).zip</PackagePath>
		<LucidCatsDir Condition="'$(LucidCatsDir)' == ''">$(LUCIDCATS_DIR)</LucidCatsDir>
		<LucidCatsManagedDir>$(LucidCatsDir)/LucidCats_Data/Managed</LucidCatsManagedDir>
		<LucidCatsBepInExDir>$(LucidCatsDir)/BepInEx</LucidCatsBepInExDir>
		<BepInExFolder Condition="'$(BepInExFolder)' == ''">plugins</BepInExFolder>
		<ZipStageDir>$(MSBuildProjectDirectory)/obj/zip/</ZipStageDir>
		<GeneratedModMetadataFile>$(MSBuildProjectDirectory)/obj/generated/ModMetadata.g.cs</GeneratedModMetadataFile>
		<GeneratedRuntimeDependenciesFile>$(MSBuildProjectDirectory)/obj/generated/RuntimeDependencies.g.cs</GeneratedRuntimeDependenciesFile>
	</PropertyGroup>
</Project>
